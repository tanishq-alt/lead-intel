# Required: Postgres connection string
DATABASE_URL="postgresql://user@localhost:5432/lead_intel?schema=public"

# App URL (for server-side fetch)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Scraper API keys (all optional — scrapers degrade gracefully) ───

# GitHub token — raises rate limit from 60/hr to 5000/hr
# Also unlocks GraphQL Discussions endpoint
# Generate at github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# LinkedIn session cookie (li_at) for Voyager company page API
# Chrome DevTools → Application → Cookies → linkedin.com → li_at
LINKEDIN_COOKIE=

# Twitter bearer token for search (falls back to public guest token if empty)
TWITTER_BEARER_TOKEN=

# YouTube Data API v3 key — better video search + accurate dates
YOUTUBE_API_KEY=

# ─── Optional integrations ───

# Supabase (alternative to direct Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ruflo MCP server
RUFLO_MCP_URL=http://localhost:3001

# Cron job secret
CRON_SECRET=
